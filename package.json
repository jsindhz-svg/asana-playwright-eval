{
  "name": "asana-playwright-eval",
  "version": "1.0.0",
  "description": "Data-driven Playwright test suite for the Asana demo application",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:regression": "playwright test tests/asana.spec.ts",
    "test:report": "playwright show-report",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
