{
  "name": "asana-playwright-eval",
  "version": "1.0.0",
  "description": "Data-driven Playwright test suite for Asana demo app",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 playwright test --workers=1",
    "test:headed": "cross-env NODE_OPTIONS=--max-old-space-size=4096 playwright test --headed --workers=1",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.0.0"
  }
}
